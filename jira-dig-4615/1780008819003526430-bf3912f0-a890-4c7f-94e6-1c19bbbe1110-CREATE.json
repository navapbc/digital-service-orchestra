{"timestamp": 1780008819003526430, "uuid": "bf3912f0-a890-4c7f-94e6-1c19bbbe1110", "event_type": "CREATE", "env_id": "reconciler", "author": "reconciler", "data": {"id": "jira-dig-4615", "ticket_type": "task", "title": "Implement suggest-test-index.sh CI failure suggestion script", "description": {"content": [{"content": [{"text": "Create plugins/dso/scripts/suggest-test-index.sh for CI failure suggestion pipeline (SC3, SC4).", "type": "text"}], "type": "paragraph"}, {"type": "paragraph"}, {"content": [{"text": "## Interface", "type": "text"}], "type": "paragraph"}, {"content": [{"text": "suggest-test-index.sh --changed-files=<file> --failing-tests=<file> [--suggestions-path=<path>]", "type": "text"}], "type": "paragraph"}, {"type": "paragraph"}, {"content": [{"text": "## Logic", "type": "text"}], "type": "paragraph"}, {"content": [{"text": "1. For each failing test, fuzzy-match against changed source files", "type": "text"}], "type": "paragraph"}, {"content": [{"text": "2. Dedup against .test-index and .test-index-suggestions before appending", "type": "text"}], "type": "paragraph"}, {"content": [{"text": "3. Ambiguous cases (0 or 2+ matches) omitted", "type": "text"}], "type": "paragraph"}, {"content": [{"text": "4. Create .test-index-suggestions if absent", "type": "text"}], "type": "paragraph"}, {"content": [{"text": "5. Apply REBASE_HEAD filter for incoming-only files", "type": "text"}], "type": "paragraph"}, {"type": "paragraph"}, {"content": [{"text": "## Output Format", "type": "text"}], "type": "paragraph"}, {"content": [{"text": "source/path.ext: test/path.ext (same as .test-index)", "type": "text"}], "type": "paragraph"}, {"type": "paragraph"}, {"content": [{"text": "## Also: chmod +x, remove .test-index RED marker", "type": "text"}], "type": "paragraph"}, {"type": "paragraph"}, {"content": [{"text": "## Acceptance Criteria", "type": "text"}], "type": "paragraph"}, {"content": [{"text": "- [ ] Script exists and is executable", "type": "text"}], "type": "paragraph"}, {"content": [{"text": "  Verify: test -x $(git rev-parse --show-toplevel)/plugins/dso/scripts/suggest-test-index.sh", "type": "text"}], "type": "paragraph"}, {"content": [{"text": "- [ ] RED marker removed", "type": "text"}], "type": "paragraph"}, {"content": [{"text": "  Verify: { grep \"suggest-test-index\" $(git rev-parse --show-toplevel)/.test-index | grep -q \"\\[\"; test \\$? -ne 0; }", "type": "text"}], "type": "paragraph"}, {"content": [{"text": "- [ ] bash tests/run-all.sh passes", "type": "text"}], "type": "paragraph"}, {"content": [{"text": "  Verify: cd $(git rev-parse --show-toplevel) && bash tests/run-all.sh", "type": "text"}], "type": "paragraph"}], "type": "doc", "version": 1}, "parent_id": "", "tags": ["imported:reconciler-bootstrap"], "priority": 2, "assignee": "Joe Oakhart"}}