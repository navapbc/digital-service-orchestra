+#
+# This test is RED because post-skill.sh does not exist yet.
+# ============================================================
+echo "--- test_post_skill_dispatcher_appends_skill_entry_to_jsonl ---"
+
+_T2_DIR=$(mktemp -d)
+_TEST_TMPDIRS+=("$_T2_DIR")
