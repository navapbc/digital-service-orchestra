+import json, sys
+expected = {"type": "skill", "skill_name": "dso:fix-bug"}
+try:
+    with open(sys.argv[1]) as f:
+        for line in f:
+            line = line.strip()
+            if not line:
+                continue
+            obj = json.loads(line)
+            if obj == expected:
+                print("match")
