+    if os.environ.get("GITHUB_EVENT_NAME", "") != "pull_request":
+        return None
+    ref = os.environ.get("GITHUB_REF", "")
+    # GITHUB_REF on PR events is "refs/pull/<N>/merge"
+    if ref.startswith("refs/pull/"):
