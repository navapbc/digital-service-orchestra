+        {
+            "severity": "fragile",
+            "category": "correctness",
+            "description": "unverifiable ref",
+            "cited_lines": ["foo:1"],
+        }
+    ]
+    exit_code, stderr = _run_main_with(diff_file, out, findings)
+    assert exit_code == 1, (
+        f"fragile finding must block (exit 1); got {exit_code}. stderr={stderr!r}"
+    )
+
