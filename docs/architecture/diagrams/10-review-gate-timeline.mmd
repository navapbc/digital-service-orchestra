  classDef pp fill:#dbeafe,stroke:#1e40af
  classDef ip fill:#dbeafe,stroke:#1e40af
  classDef sp fill:#dbeafe,stroke:#1e40af
  classDef ci fill:#fce7f3,stroke:#9d174d
  class bs_gates bs
  class pp_gates pp
  class ip_gates ip
  class sp_gates sp
  class ci_gates ci
